#!/bin/sh /etc/rc.common
# One-shot first-boot installer for Open-Box. The proprietary package is not
# bundled in the firmware; it is downloaded from the official GitHub Release.

START=99
STOP=10
USE_PROCD=1

start_service() {
	if [ -e /opt/open-box/open-box ] || [ -e /opt/open-box/bin/open-box ]; then
		return 0
	fi

	procd_open_instance
	procd_set_param command /bin/sh -c '
		for i in $(seq 1 60); do
			ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && break
			nslookup github.com >/dev/null 2>&1 && break
			sleep 10
		done
		/usr/sbin/openbox-install --port 3036 >> /root/openbox-install.log 2>&1 || \
		/usr/sbin/openbox-install --port 3036 --mirror >> /root/openbox-install.log 2>&1
	'
	procd_set_param respawn 0 0 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
